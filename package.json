{
  "name": "unsta-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname localhost --port 3000",
    "build": "next build --webpack && node scripts/prepare-standalone.mjs",
    "start": "node --env-file-if-exists=.env.local .next/standalone/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@tailwindcss/postcss": "4.3.3",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.1",
    "lucide-react": "1.66.0",
    "next": "16.4.3",
    "next-themes": "0.4.6",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "shadcn": "4.23.0",
    "sonner": "2.0.8",
    "swr": "2.5.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "prettier": "3.9.10",
    "tsx": "4.20.6"
  },
  "engines": {
    "node": ">=22"
  }
}
